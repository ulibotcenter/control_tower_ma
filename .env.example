# ─── Controle (Supabase) ───────────────────────────────────────────
# Persistência da bandeja / classificação / decisões = URL + SERVICE ROLE.
# Sem SERVICE_ROLE a torre usa seed + .data/ (só serve em local).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Documentos (Google Drive) ─────────────────────────────────────
# Sem estas chaves a torre NÃO lê o Drive. Bandeja = manual.
# Pasta raiz do programa (não use o disco do Mac).
GOOGLE_DRIVE_FOLDER_ID=1VlZu-j9unQWpcjf9oqEkLIyIzjUiJAuS
# Uma das duas formas:
GOOGLE_SERVICE_ACCOUNT=
# ou
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Domínio canônico (Vercel: tower.elevaprojects.com)
NEXT_PUBLIC_APP_URL=https://tower.elevaprojects.com

# ─── Auth ──────────────────────────────────────────────────────────
# Sem signup. Contas criadas à mão no painel do Supabase.
# OBRIGATÓRIA e sem fallback: sem SESSION_SECRET a torre não assina sessão,
# não faz login e devolve a tela de configuração. Vazio conta como ausente.
SESSION_SECRET=troque-isto-em-producao
# Fallback HMAC (só @elevaprojects.com) se SUPABASE_AUTH estiver desligado.
ELEVA_DEV_PASSWORD=
# true só em local. Em produção: false.
ALLOW_DEV_LOGIN=false
NEXT_PUBLIC_SESSION_IDLE_MINUTES=90
# 1 ou true = login individual (signInWithPassword + ANON_KEY). Sem service role.
SUPABASE_AUTH=1

# ─── Alertas ───────────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_EMAIL=erica@elevaprojects.com
ALERT_FROM=Control Tower <noreply@elevaprojects.com>
CRON_SECRET=
