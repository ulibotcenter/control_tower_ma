# ─── Controle (Supabase) ───────────────────────────────────────────
# Verdade do status, semáforo, donos, prazos, riscos, decisões.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Documentos (Google Drive) ─────────────────────────────────────
# Sem estas chaves a torre NÃO lê o Drive. Bandeja = manual.
# Pasta raiz do programa (não use o disco do Mac).
GOOGLE_DRIVE_FOLDER_ID=1VlZu-j9unQWpcjf9oqEkLIyIzjUiJAuS
# Uma das duas formas:
GOOGLE_SERVICE_ACCOUNT=
# ou
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─── Auth Eleva ────────────────────────────────────────────────────
# Sem signup. Só @elevaprojects.com.
SESSION_SECRET=troque-isto-em-producao
ELEVA_DEV_PASSWORD=
# true só em local (.env.local). Em produção: false + ELEVA_DEV_PASSWORD ou Supabase.
ALLOW_DEV_LOGIN=false

# ─── Alertas ───────────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_EMAIL=erica@elevaprojects.com
ALERT_FROM=Control Tower <noreply@elevaprojects.com>
CRON_SECRET=
